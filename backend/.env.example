# Slotify Backend Environment Configuration Example
# Copy this file to .env and configure for your environment

# Server Port (Render automatically sets PORT)
PORT=5000

# Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/slotify?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/slotify

# JWT Signing Secret (Use a strong random secret in production)
JWT_SECRET=development_secret_key_change_in_production

# JWT Expiration
JWT_EXPIRES_IN=1d

# Allowed Frontend Client URL(s) for CORS Whitelisting
# Multiple origins can be comma-separated: http://localhost:5173,https://slotify.vercel.app
CLIENT_URL=http://localhost:5173

# Authentication Cookie Name
COOKIE_NAME=slotify_token
